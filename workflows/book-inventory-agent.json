        "toolDescription": "Update an existing book in the Books table. First call search_books to get the record id of the exact book, then pass that id plus the new Quantity on Hand and Min Quantity (send the current value for any field the user is not changing).",
        "resource": "record",
        "operation": "update",
        "base": { "__rl": true, "value": "app36dsMp7OBecovO", "mode": "list", "cachedResultName": "Book Inventory Tracker", "cachedResultUrl": "https://airtable.com/app36dsMp7OBecovO" },
        "table": { "__rl": true, "value": "tblynJGo0IyKf5ujd", "mode": "list", "cachedResultName": "Books", "cachedResultUrl": "https://airtable.com/app36dsMp7OBecovO/tblynJGo0IyKf5ujd" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $fromAI(\"recordId\", \"Airtable record id of the book to update, e.g. recXXXXXXXXXXXXXX, taken from search_books results\", \"string\") }}",
            "Quantity on Hand": "={{ $fromAI(\"Quantity_on_Hand\", \"New Quantity on Hand for the book\", \"number\") }}",
            "Min Quantity": "={{ $fromAI(\"Min_Quantity\", \"New Min Quantity for the book\", \"number\") }}"
          },
          "matchingColumns": ["id"],
          "schema": [
