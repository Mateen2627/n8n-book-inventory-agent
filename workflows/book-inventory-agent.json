            { "id": "Quantity on Hand", "displayName": "Quantity on Hand", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "number", "readOnly": false, "removed": false },
            { "id": "Min Quantity", "displayName": "Min Quantity", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "number", "readOnly": false, "removed": false }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": { "typecast": true }
      },
      "credentials": { "airtableTokenApi": { "id": "dM84RqBNFLZZYdew", "name": "Airtable Personal Access Token account" } }
    },
