  "name": "My workflow 2",
  "nodes": [
    {
      "id": "4dc65d1e-3a9b-4d40-af5a-e0cccae22f05",
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.5,
      "position": [100, 300],
      "webhookId": "2d722de5-8c29-4570-9aa3-05e127f741ab",
      "parameters": { "options": {} }
    },
    {
      "id": "4dc924de-8d2d-4e21-a808-4574d5681b8f",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [300, 300],
      "parameters": {
        "options": {
          "systemMessage": "You are an inventory assistant for a book store with access to the Airtable base \"Book Inventory Tracker\" (table \"Books\"). The base and table are already configured: never ask the user for a base ID, table name or field names. Tools: search_books lists every book with its record id and fields; update_book changes Quantity on Hand and Min Quantity of an existing book; create_book adds a new book. For any question about books, stock, quantities, Min Quantity, Reorder Threshold, location or price, call search_books with a title keyword first (empty keyword only when the whole inventory is needed) and answer from the returned records. To change a book: call search_books, find the exact book, then call update_book with its record id (starts with rec) and the new values, keeping the current value for any field not being changed. To add a book: check with search_books that it does not exist, then call create_book. Bulk changes: when the user asks to change many books at once, call search_books once with an empty keyword, then call update_book for every matching book. After a change, confirm what was updated in one short line per book. Be concise; use a list or table when showing several books."
        }
      },
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 5000
    },
    {
      "id": "8b7f4a0d-1986-408a-94fe-721ffdc2f240",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [100, 450],
      "parameters": {
        "model": { "__rl": true, "mode": "list", "value": "gpt-5.4-mini", "cachedResultName": "gpt-5.4-mini" },
        "options": { "reasoningEffort": "low" }
      }
    },
    {
      "id": "122d6af2-569b-4277-841e-392daf815a1e",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [100, 600],
      "parameters": { "contextWindowLength": 3 }
    },
    {
      "id": "b98c33d4-a0da-4e62-b73b-7c70c3bd4f17",
      "name": "search_books",
      "type": "n8n-nodes-base.airtableTool",
      "typeVersion": 2.2,
      "position": [100, 750],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Find books (record id, Title, Author, Quantity on Hand, Min Quantity, Reorder Threshold, Location, Unit Cost) in the Books table. Pass a title keyword to get only matching books; pass an empty string only when the user needs the whole inventory.",
        "operation": "search",
        "filterByFormula": "={{ \"SEARCH(LOWER(\\\"\" + $fromAI(\"title_keyword\", \"Part of the book title to search for, or empty string to list all books\", \"string\").replace(/\"/g, \"\") + \"\\\"), LOWER({Title}))\" }}",
        "base": { "__rl": true, "value": "app36dsMp7OBecovO", "mode": "list", "cachedResultName": "Book Inventory Tracker", "cachedResultUrl": "https://airtable.com/app36dsMp7OBecovO" },
        "table": { "__rl": true, "value": "tblynJGo0IyKf5ujd", "mode": "list", "cachedResultName": "Books", "cachedResultUrl": "https://airtable.com/app36dsMp7OBecovO/tblynJGo0IyKf5ujd" },
        "options": { "fields": ["Title", "Author", "Quantity on Hand", "Min Quantity", "Reorder Threshold", "Location", "Unit Cost"] }
      },
      "credentials": { "airtableTokenApi": { "id": "dM84RqBNFLZZYdew", "name": "Airtable Personal Access Token account" } }
    },
    {
      "id": "e4e61539-0ddb-4b5d-9b2f-e5a317de7518",
